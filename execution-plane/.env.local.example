# Copy this file to execution-plane/.env.local for local real LLM testing.
# Do not commit .env.local.

DEVFLOW_LLM_PROVIDER=openai_compatible
DEVFLOW_LLM_CONFIG_FILE=./config/llm.local.json
DEVFLOW_LLM_INTEGRATION_TEST=1
DEVFLOW_LLM_TIMEOUT_SECONDS=240
DEVFLOW_LLM_TIMEOUT_PROGRESSIVE_CONTEXT_EXPLORATION_PLAN=120
DEVFLOW_LLM_TIMEOUT_REQUIREMENT_ANALYSIS=180
DEVFLOW_LLM_TIMEOUT_SYSTEM_DESIGN=360
DEVFLOW_LLM_TIMEOUT_CODE_GENERATION=240
DEVFLOW_LLM_TIMEOUT_TEST_GENERATION=240

# OpenAI-compatible provider
DEVFLOW_LLM_OPENAI_API_KEY=
DEVFLOW_LLM_OPENAI_BASE_URL=https://api.openai.com/v1
DEVFLOW_LLM_OPENAI_DEFAULT_MODEL=gpt-4o-mini

# Anthropic-compatible provider
DEVFLOW_LLM_ANTHROPIC_API_KEY=
DEVFLOW_LLM_ANTHROPIC_BASE_URL=https://api.anthropic.com/v1
DEVFLOW_LLM_ANTHROPIC_DEFAULT_MODEL=claude-3-5-haiku-latest

# Optional trace output for debugging real LLM tests.
# The trace contains prompts, model responses and agent intermediate artifacts.
DEVFLOW_LLM_TRACE=0
DEVFLOW_LLM_TRACE_STDOUT=1
DEVFLOW_LLM_TRACE_FILE=./logs/llm-trace.jsonl
DEVFLOW_LLM_TRACE_MAX_CHARS=50000
